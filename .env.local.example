# ============================================================
# FrontierAngels.com Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ------------------------------------------------------------
# Clerk Authentication (https://clerk.com)
# Get from: Clerk Dashboard → API Keys
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/members/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/members/dashboard

# Clerk webhook signing secret (Clerk Dashboard → Webhooks → your endpoint)
# Endpoint URL: https://<your-domain>/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Airtable (https://airtable.com/developers)
# Get from: Airtable Account → Developer Hub → Personal Access Token
# ------------------------------------------------------------
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Airtable Base IDs (find in URL: airtable.com/appXXXXXX/...)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# (Table IDs are hardcoded in lib/airtable.ts — no per-table env vars needed.)

# ------------------------------------------------------------
# App Config
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production: NEXT_PUBLIC_APP_URL=https://portal.frontierangels.com

# "Back to main site" link target in the sidebar (defaults to frontierangels.com)
NEXT_PUBLIC_MARKETING_URL=https://frontierangels.com

# ------------------------------------------------------------
# Admin tools (/admin, /api/test) — comma-separated allowlist of emails
# ------------------------------------------------------------
ADMIN_EMAILS=graham@frontierangels.com

# ------------------------------------------------------------
# DEV ONLY — preview the portal as any member (ignored in production).
# Leave UNSET in production.
# ------------------------------------------------------------
# DEV_PREVIEW_EMAIL=bcebull@gtuit.com
